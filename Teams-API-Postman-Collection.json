{
  "info": {
    "name": "Teams Platform API - Phase 1, 2, 3, 4",
    "description": "Complete API collection for Teams collaboration platform with all endpoints from Phase 1 (Auth & Users), Phase 2 (Teams/Channels/Messages), Phase 3 (Attachments/Notifications/AuditLogs), and Phase 4 (Organizations & Members)",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "team_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "channel_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "message_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "attachment_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "organization_id",
      "value": "1",
      "type": "string"
